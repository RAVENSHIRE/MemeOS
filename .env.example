# Google AI Studio supplies this secret at runtime when configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Hosted application URL (AI Studio / Cloud Run).
APP_URL="MY_APP_URL"

# Optional existing MEME OS adapters. Leave empty to show DISCONNECTED.
# Adapters should return JSON: { "signals": [{ "tokenAddress": "...", "source": "...", "score": 80 }] }.
# Configure only endpoints you control and trust. Never expose secret keys via VITE_* variables.
X_SIGNAL_URL=""
ONCHAIN_SIGNAL_URL=""
PUMPSWAP_SIGNAL_URL=""

# Optional Solana RPC endpoint for a wallet read-only adapter.
# Presence alone does not enable mainnet trading or prove RPC health.
SOLANA_RPC_URL=""
